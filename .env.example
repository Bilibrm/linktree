# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/linknest?retryWrites=true&w=majority

# NextAuth
AUTH_SECRET=your-random-secret-at-least-32-chars-long
AUTH_URL=http://localhost:3000

# For production, set:
# AUTH_URL=https://your-app.vercel.app

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=linknest-uploads

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# For production:
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
